# LibraLink Desk - NON-SECRET LibreChat settings (safe to commit).
# Secrets (API key, encryption keys) are NOT here. ops/start.sh reads them from
# AWS Systems Manager Parameter Store at start-up and passes them to the container.

APP_TITLE=LibraLink Desk
CUSTOM_FOOTER=LibraLink Desk · Luntian Ridge University Library (fictional, SAM10 project) · Built on LibreChat (MIT)

# Only the Google (Gemini) endpoint is switched on.
ENDPOINTS=google

# Accounts are created by the operators (npm run create-user). No public sign-up, no social login.
ALLOW_EMAIL_LOGIN=true
ALLOW_REGISTRATION=false
ALLOW_SOCIAL_LOGIN=false
ALLOW_SOCIAL_REGISTRATION=false
ALLOW_PASSWORD_RESET=false

# Conversation search (Meilisearch) is not used; it keeps the server small.
SEARCH=false

# Normal (non-debug) logging, written as JSON so CloudWatch can search it.
DEBUG_LOGGING=false
DEBUG_CONSOLE=false
CONSOLE_JSON=true

# Limits so one user (or a stuck script) cannot burn through the free model quota.
LIMIT_MESSAGE_USER=true
MESSAGE_USER_MAX=40
MESSAGE_USER_WINDOW=60
LIMIT_CONCURRENT_MESSAGES=true
CONCURRENT_MESSAGE_MAX=2

HOST=0.0.0.0
PORT=3080
