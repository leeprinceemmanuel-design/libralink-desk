{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SwitchIntoAdminRoleOnlyWithMfa",
      "Effect": "Allow",
      "Action": "sts:AssumeRole",
      "Resource": "arn:aws:iam::__ACCOUNT_ID__:role/SAM10-Admin",
      "Condition": { "Bool": { "aws:MultiFactorAuthPresent": "true" } }
    }
  ]
}
